# Fill this in. This file is gitignored and never leaves your machine.
# After editing, run ./render-config.sh then: docker compose restart

# Does all three jobs: speech to text, the replies, and nothing else needed.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Your laptop's address on your home network. This is what the cat dials.
HOST_LAN_IP=192.168.4.46

# Web search for the cat, used by the web_search plugin in claude-voice.
# Get one at app.tavily.com, it starts with tvly-
TAVILY_API_KEY=

# The bubble tea callout, tools/callout.py. It emails a trigger to CALLOUT_TO,
# and an iPhone Shortcut watching for that email speaks the line out loud.
# CALLOUT_TO should be an @icloud.com address, because iCloud mail reaches the
# phone within seconds and Gmail in Apple Mail can take fifteen minutes.
# Sending through iCloud needs an app-specific password from account.apple.com
# (smtp.mail.me.com, port 587). Gmail works too with an app password.
CALLOUT_SMTP_HOST=smtp.mail.me.com
CALLOUT_SMTP_PORT=587
CALLOUT_SMTP_USER=
CALLOUT_SMTP_PASSWORD=
CALLOUT_FROM=
CALLOUT_TO=
# What OwnTracks sends as its password, with the username cat.
CALLOUT_PASSWORD=
