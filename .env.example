# Copy to .env and fill in. .env is gitignored and never leaves this machine.

# The brain. Create at https://console.anthropic.com/settings/keys
# Your Claude Code subscription is separate from this; you need an API key.
ANTHROPIC_API_KEY=

# Speech to text. You already have this one.
OPENAI_API_KEY=

# The LAN address the cat will be told to connect to.
# This is your laptop's address on your home network.
HOST_LAN_IP=192.168.4.46
